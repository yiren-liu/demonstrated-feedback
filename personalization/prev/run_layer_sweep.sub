#!/bin/bash
#SBATCH -J layer_sweep
#SBATCH -o /home/cz468/personalization/logs/layer_sweep_%j.out  # output file (%j expands to jobID)
#SBATCH -e /home/cz468/personalization/logs/layer_sweep_%j.err  # error log file (%j expands to jobID)
#SBATCH --mail-type=ALL                      # Request status by email
#SBATCH --mail-user=cz468@cornell.edu        # Email address to send results to.
#SBATCH -N 1                                 # Total number of nodes requested
#SBATCH -n 4                                 # Total number of cores requested
#SBATCH --mem=20000                          # server memory requested (per node)
#SBATCH -t 160:00:00                         # Time limit (hh:mm:ss)
#SBATCH --partition=default_partition        # Request partition
#SBATCH --gres=gpu:nvidia_rtx_6000_ada_generation :1   # Type:number of GPUs needed

# Set project paths
PROJECT_PATH=/home/cz468/personalization
DATASET=v5-gpt-5-mini
START_LAYER=15
END_LAYER=31
MODEL=meta-llama/Llama-3.1-8B-Instruct
MULTIPLIER=3.0

# Activate conda environment
eval "$(conda shell.bash hook)"
conda activate llm

# Add project path to PYTHONPATH
export PYTHONPATH=$PROJECT_PATH:$PYTHONPATH

# Run layer sweep
echo "Running layer sweep..."
python3 $PROJECT_PATH/single_vector/run_layer_sweep.py \
    --dataset $DATASET \
    --start_layer $START_LAYER \
    --end_layer $END_LAYER \
    --model $MODEL \
    --multiplier $MULTIPLIER

# Deactivate conda environment
conda deactivate

# Unset variables
unset PROJECT_PATH
unset DATASET
unset START_LAYER
unset END_LAYER
unset MODEL
unset BATCH_SIZE
unset MULTIPLIER
