#!/bin/bash
#SBATCH -J synthesize_writing_samples
#SBATCH -o /home/cz468/personalization/logs/synthesize_writing_samples_%j.out  # output file (%j expands to jobID)
#SBATCH -e /home/cz468/personalization/logs/synthesize_writing_samples_%j.err  # error log file (%j expands to jobID)
#SBATCH --mail-type=ALL                      # Request status by email
#SBATCH --mail-user=cz468@cornell.edu        # Email address to send results to.
#SBATCH -N 1                                 # Total number of nodes requested
#SBATCH -n 4                                 # Total number of cores requested
#SBATCH --mem=20000                          # server memory requested (per node)
#SBATCH -t 160:00:00                         # Time limit (hh:mm:ss)
#SBATCH --partition=default_partition        # Request partition
#SBATCH --gres=gpu:nvidia_rtx_a6000:1        # Type:number of GPUs needed

# Set project paths
PROJECT_PATH=/home/cz468/personalization

# Activate conda environment
eval "$(conda shell.bash hook)"
conda activate llm

# Add project path to PYTHONPATH so synthesis module can be found
export PYTHONPATH=$PROJECT_PATH:$PYTHONPATH

# Run the synthesis pipeline
python -m synthesis.run \
    --output_dir ./synthesis/output/email \
    --n_personas 20 \
    --n_scenarios 20 \
    --n_tasks 25 \
    --writing-type email

# Deactivate conda environment
conda deactivate

# Unset variables
unset PROJECT_PATH
unset OUTPUT_DIR
