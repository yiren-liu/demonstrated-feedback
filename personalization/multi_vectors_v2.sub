#!/bin/bash
#SBATCH -J multi_vectors_v2
#SBATCH -o /home/cz468/personalization/logs/multi_vectors_v2_%j.out  # output file (%j expands to jobID)
#SBATCH -e /home/cz468/personalization/logs/multi_vectors_v2_%j.err  # error log file (%j expands to jobID)
#SBATCH --mail-type=ALL                      # Request status by email
#SBATCH --mail-user=cz468@cornell.edu        # Email address to send results to.
#SBATCH -N 1                                 # Total number of nodes requested
#SBATCH -n 4                                 # Total number of cores requested
#SBATCH --mem=80000                          # server memory requested (per node)
#SBATCH -t 160:00:00                         # Time limit (hh:mm:ss)
#SBATCH --partition=default_partition        # Request partition
#SBATCH --gres=gpu:nvidia_rtx_a6000:1        # Type:number of GPUs needed

# Set project paths
PROJECT_PATH=/home/cz468/personalization

# Activate conda environment
eval "$(conda shell.bash hook)"
conda activate llm

# Add project path to PYTHONPATH so multi_vectors module can be found
export PYTHONPATH=$PROJECT_PATH:$PYTHONPATH

# Run the multi_vectors pipeline
python -m multi_vectors.run_v2 --dataset email --k 1 --output multi_vectors/outputs_cluster_by_gt --multiplier 0.12 --skip-infer-test

# Merge results for validation set
python -m merge multi_vectors/outputs_cluster_by_gt/results/val/email -o evaluation/dataset/val/email/multi_vectors_cluster_by_gt_m012_email_val.csv

# # Merge results for test set
# python -m merge multi_vectors/outputs_cluster_by_gt/results/test/email -o evaluation/dataset/test/email/multi_vectors_cluster_by_gt_m012_email_test.csv

# Run evaluation on validation set
python -m evaluation.run --csv_path evaluation/dataset/val/email/multi_vectors_cluster_by_gt_m012_email_val.csv

# # Run evaluation on test set
# python -m evaluation.run --csv_path evaluation/dataset/test/email/multi_vectors_cluster_by_gt_m012_email_test.csv

# Deactivate conda environment
conda deactivate

# Unset variables
unset PROJECT_PATH
unset OUTPUT_DIR
